{
  "compilerOptions": {
    "sourceMap": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "outDir": "./dist",
    "rootDir": "..",
    "isolatedModules": false,
    "resolveJsonModule": true,
    "types": ["node"]
  }
}
